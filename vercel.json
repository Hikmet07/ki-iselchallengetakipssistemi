{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(style\\.css|app\\.js)",
      "dest": "static/$1"
    },
    {
      "src": "/",
      "dest": "static/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
